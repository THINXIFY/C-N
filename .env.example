# Copy to .env.local and set real values. Never commit .env.local.

# FIRST-RUN SEEDING ONLY.
# The first time the app runs it creates its user store (.data/db.json) from these values, hashing the
# password and access code on the server. After that, accounts are managed in Admin → Users and these
# credentials are no longer used for sign-in.
USER_USERNAME=
USER_PASSWORD=
USER_ACCESS_CODE=

ADMIN_USERNAME=
ADMIN_PASSWORD=

# Random string (32+ chars) used to sign session cookies. Required.
SESSION_SECRET=
